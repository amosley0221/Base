<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- App theme: forces the system status bar + nav bar to BASE's dark
       background in every orientation (the web theme-color only reaches
       the status bar in portrait on a TWA). -->
  <style name="Theme.Base" parent="@android:style/Theme.DeviceDefault.NoActionBar">
    <item name="android:windowBackground">@color/backgroundColor</item>
    <item name="android:statusBarColor">@color/backgroundColor</item>
    <item name="android:navigationBarColor">@color/backgroundColor</item>
    <item name="android:windowLightStatusBar">false</item>
  </style>
</resources>
